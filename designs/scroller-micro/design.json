{
  "schema_version": "1.0",
  "id": "scroller-micro",
  "name": "SuperMini Scroller",
  "description": "ESP32-C3 Super Mini driving a 1.3in OLED + rotary encoder + two-button panel module over I2C.",
  "board": {
    "library_id": "esp32-c3-supermini",
    "mcu": "esp32",
    "framework": "arduino"
  },
  "power": {
    "supply": "usb-5v",
    "rail_voltage_v": 5,
    "budget_ma": 500
  },
  "requirements": [],
  "components": [
    {
      "id": "onboard_led",
      "library_id": "gpio_output",
      "label": "Onboard LED",
      "params": {}
    },
    {
      "id": "onboard_button",
      "library_id": "gpio_input",
      "label": "Onboard button",
      "params": {
        "filters": [
          {
            "invert": null
          }
        ]
      }
    },
    {
      "id": "disp",
      "library_id": "ssd1306",
      "label": "Panel OLED",
      "params": {
        "model": "SH1106 128x64",
        "address": "0x3C"
      },
      "module": {
        "module_id": "oled-knob-13",
        "instance": "oled-knob-13-1"
      }
    },
    {
      "id": "knob",
      "library_id": "rotary_encoder",
      "label": "Menu knob",
      "params": {},
      "module": {
        "module_id": "oled-knob-13",
        "instance": "oled-knob-13-1"
      }
    },
    {
      "id": "knobsw",
      "library_id": "gpio_input",
      "label": "Knob press",
      "params": {},
      "module": {
        "module_id": "oled-knob-13",
        "instance": "oled-knob-13-1"
      }
    },
    {
      "id": "btn1",
      "library_id": "gpio_input",
      "label": "Button A",
      "params": {},
      "module": {
        "module_id": "oled-knob-13",
        "instance": "oled-knob-13-1"
      }
    },
    {
      "id": "btn2",
      "library_id": "gpio_input",
      "label": "Button B",
      "params": {},
      "module": {
        "module_id": "oled-knob-13",
        "instance": "oled-knob-13-1"
      }
    }
  ],
  "buses": [
    {
      "id": "i2c_1",
      "type": "i2c",
      "sda": "GPIO6",
      "scl": "GPIO7"
    }
  ],
  "connections": [
    {
      "component_id": "onboard_led",
      "pin_role": "OUT",
      "target": {
        "kind": "gpio",
        "pin": "GPIO8"
      }
    },
    {
      "component_id": "onboard_button",
      "pin_role": "IN",
      "target": {
        "kind": "gpio",
        "pin": "GPIO9"
      }
    },
    {
      "component_id": "disp",
      "pin_role": "VCC",
      "target": {
        "kind": "rail",
        "rail": "3V3"
      }
    },
    {
      "component_id": "disp",
      "pin_role": "GND",
      "target": {
        "kind": "rail",
        "rail": "GND"
      }
    },
    {
      "component_id": "disp",
      "pin_role": "SDA",
      "target": {
        "kind": "bus",
        "bus_id": "i2c_1"
      }
    },
    {
      "component_id": "disp",
      "pin_role": "SCL",
      "target": {
        "kind": "bus",
        "bus_id": "i2c_1"
      }
    },
    {
      "component_id": "disp",
      "pin_role": "RESET",
      "target": {
        "kind": "gpio",
        "pin": "GPIO4"
      }
    },
    {
      "component_id": "knob",
      "pin_role": "A",
      "target": {
        "kind": "gpio",
        "pin": "GPIO2"
      }
    },
    {
      "component_id": "knob",
      "pin_role": "B",
      "target": {
        "kind": "gpio",
        "pin": "GPIO0"
      }
    },
    {
      "component_id": "knobsw",
      "pin_role": "IN",
      "target": {
        "kind": "gpio",
        "pin": "GPIO1"
      }
    },
    {
      "component_id": "btn1",
      "pin_role": "IN",
      "target": {
        "kind": "gpio",
        "pin": "GPIO10"
      }
    },
    {
      "component_id": "btn2",
      "pin_role": "IN",
      "target": {
        "kind": "gpio",
        "pin": "GPIO3"
      }
    }
  ],
  "passives": [],
  "warnings": [],
  "esphome_extras": {
    "logger": {}
  },
  "fleet": {
    "device_name": "scroller-micro",
    "tags": [],
    "secrets_ref": {
      "wifi_ssid": "!secret wifi_ssid",
      "wifi_password": "!secret wifi_password",
      "api_key": "!secret api_key"
    }
  }
}
